<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080b14">
<meta name="description" content="Daily AI Hub News Viewer - Indian and Global News">
<title>News Viewer • Daily AI Hub</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#080b14;
  color:#fff;
  line-height:1.6;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#0d1120;
  border-bottom:1px solid #292f49;
  padding:15px 18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:22px;
  font-weight:800;
}

.logo span{
  color:#6c63ff;
}

.home-btn{
  color:#fff;
  text-decoration:none;
  background:#171c31;
  border:1px solid #353b5b;
  padding:9px 14px;
  border-radius:10px;
  font-weight:bold;
}

.container{
  max-width:900px;
  margin:auto;
  padding:22px 16px 70px;
}

.top-title{
  margin:10px 0 18px;
}

.top-title h1{
  font-size:32px;
  margin-bottom:5px;
}

.top-title p{
  color:#9da5c2;
}

.controls{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin:20px 0;
}

.controls input,
.controls select{
  flex:1;
  min-width:150px;
  background:#111629;
  color:#fff;
  border:1px solid #303752;
  border-radius:10px;
  padding:12px;
  outline:none;
}

.trending{
  margin:20px 0;
}

.trending-title{
  font-size:23px;
  margin-bottom:12px;
}

.trending-box{
  background:linear-gradient(135deg,#271526,#15182b);
  border:1px solid #a92e58;
  border-radius:16px;
  padding:18px;
}

.badge{
  display:inline-block;
  background:#ed2855;
  padding:6px 11px;
  border-radius:8px;
  font-size:12px;
  font-weight:bold;
  margin-bottom:12px;
}

.trending-box h2{
  font-size:22px;
  line-height:1.35;
}

.news-list{
  display:grid;
  gap:14px;
  margin-top:25px;
}

.news-card{
  background:#111629;
  border:1px solid #292f49;
  border-radius:16px;
  padding:18px;
  transition:.2s;
}

.news-card:hover{
  border-color:#6c63ff;
  transform:translateY(-2px);
}

.news-meta{
  color:#8e96b5;
  font-size:13px;
  margin-bottom:8px;
}

.news-card h2{
  font-size:20px;
  line-height:1.4;
  margin-bottom:10px;
}

.news-summary{
  color:#b2b8ce;
  font-size:15px;
}

.read-btn{
  display:inline-block;
  margin-top:15px;
  background:#6c63ff;
  color:#fff;
  text-decoration:none;
  padding:9px 14px;
  border-radius:9px;
  font-weight:bold;
}

.viewer{
  display:none;
}

.viewer-card{
  background:#101426;
  border:1px solid #303752;
  border-radius:18px;
  padding:22px;
}

.back-btn{
  display:inline-block;
  color:#aeb4ff;
  text-decoration:none;
  margin-bottom:20px;
  font-weight:bold;
}

.viewer-badge{
  display:inline-block;
  background:#6c63ff;
  padding:7px 12px;
  border-radius:8px;
  font-size:12px;
  font-weight:bold;
  margin-bottom:15px;
}

.viewer h1{
  font-size:34px;
  line-height:1.3;
  margin-bottom:12px;
}

.viewer-info{
  color:#8f98b5;
  font-size:14px;
  margin-bottom:20px;
}

.viewer-summary{
  color:#c0c5d8;
  font-size:18px;
  margin-bottom:22px;
}

.viewer-content{
  font-size:17px;
  color:#e4e6ef;
}

.viewer-content p{
  margin-bottom:18px;
}

.source-btn{
  display:inline-block;
  margin-top:20px;
  background:#202744;
  border:1px solid #3b456b;
  color:#fff;
  text-decoration:none;
  padding:11px 15px;
  border-radius:10px;
}

.loading{
  text-align:center;
  padding:35px;
  color:#929ab8;
}

.error{
  background:#241521;
  border:1px solid #7e294c;
  padding:16px;
  border-radius:12px;
  color:#ffb4c8;
}

.empty{
  text-align:center;
  padding:35px;
  color:#969eb8;
}

footer{
  text-align:center;
  color:#777f9c;
  padding:25px;
  border-top:1px solid #20263b;
}

@media(max-width:600px){

  .logo{
    font-size:20px;
  }

  .home-btn{
    padding:8px 10px;
    font-size:13px;
  }

  .top-title h1{
    font-size:28px;
  }

  .viewer h1{
    font-size:27px;
  }

  .viewer-summary{
    font-size:16px;
  }

  .viewer-content{
    font-size:16px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">🤖 Daily <span>AI Hub</span></div>
  <a class="home-btn" href="index.html">🏠 Home</a>
</header>

<main class="container">

  <!-- NEWS LIST -->
  <section id="newsHome">

    <div class="top-title">
      <h1>📰 News</h1>
      <p>Indian & Global News • Trending • Technology • Sports • Movies</p>
    </div>

    <div class="controls">
      <input
        type="search"
        id="searchBox"
        placeholder="🔎 Search news..."
        oninput="filterNews()"
      >

      <select id="languageFilter" onchange="filterNews()">
        <option value="all">🌐 All Languages</option>
        <option value="English">English</option>
        <option value="Hindi">हिंदी</option>
        <option value="Marathi">मराठी</option>
        <option value="Bengali">বাংলা</option>
        <option value="Tamil">தமிழ்</option>
        <option value="Telugu">తెలుగు</option>
        <option value="Kannada">ಕನ್ನಡ</option>
        <option value="Malayalam">മലയാളം</option>
        <option value="Gujarati">ગુજરાતી</option>
        <option value="Punjabi">ਪੰਜਾਬੀ</option>
      </select>

      <select id="categoryFilter" onchange="filterNews()">
        <option value="all">📂 All Categories</option>
        <option value="India">🇮🇳 India</option>
        <option value="World">🌎 World</option>
        <option value="Technology">💻 Technology</option>
        <option value="AI">🤖 AI</option>
        <option value="Cricket">🏏 Cricket</option>
        <option value="Movies">🎬 Movies</option>
        <option value="Business">💰 Business</option>
        <option value="Sports">🏆 Sports</option>
      </select>
    </div>

    <section class="trending" id="trendingSection">
      <div class="trending-title">🔥 Trending Now</div>
      <div class="trending-box" id="trendingBox">
        <div class="loading">Loading trending news...</div>
      </div>
    </section>

    <div id="newsList" class="news-list">
      <div class="loading">📰 Loading latest news...</div>
    </div>

  </section>


  <!-- SINGLE NEWS VIEWER -->
  <section id="viewer" class="viewer">

    <a href="news.html" class="back-btn">← Back to News</a>

    <article class="viewer-card">

      <div id="viewerBadge" class="viewer-badge">
        NEWS
      </div>

      <h1 id="viewerTitle">
        Loading...
      </h1>

      <div id="viewerInfo" class="viewer-info"></div>

      <div id="viewerSummary" class="viewer-summary"></div>

      <div id="viewerContent" class="viewer-content"></div>

      <a
        id="sourceBtn"
        class="source-btn"
        href="#"
        target="_blank"
        rel="noopener"
      >
        🔗 Original Source
      </a>

    </article>

  </section>

</main>

<footer>
  © 2026 Daily AI Hub • Indian & Global News
</footer>


<script>

let allNews = [];


/* LOAD NEWS */

async function loadNews(){

  const list = document.getElementById("newsList");

  try{

    const response = await fetch("news.json?cache=" + Date.now());

    if(!response.ok){
      throw new Error("News file not found");
    }

    const data = await response.json();

    allNews = Array.isArray(data)
      ? data
      : (data.articles || []);

    if(!allNews.length){

      list.innerHTML =
        '<div class="empty">📰 No news available right now.</div>';

      return;
    }

    showTrending();
    filterNews();

    openSelectedNews();

  }catch(error){

    list.innerHTML = `
      <div class="error">
        ⚠️ News load नहीं हो सकी।<br><br>
        कृपया check करें कि <b>news.json</b> file repository में मौजूद है।
      </div>
    `;

    console.error(error);
  }
}


/* TRENDING */

function showTrending(){

  const box = document.getElementById("trendingBox");

  const trending =
    allNews.find(n =>
      n.trending === true ||
      n.trending === "true"
    ) || allNews[0];

  if(!trending) return;

  const id =
    trending.id ||
    trending.url ||
    encodeURIComponent(trending.title);

  box.innerHTML = `
    <div class="badge">🔥 TRENDING</div>

    <h2>${escapeHTML(trending.title || "Trending News")}</h2>

    <div class="news-meta">
      ${escapeHTML(trending.category || "News")}
      •
      ${escapeHTML(trending.language || "English")}
    </div>

    <a class="read-btn"
       href="news.html?id=${encodeURIComponent(id)}">
       Read Full News →
    </a>
  `;
}


