<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#080b14">
<title>News Viewer | Daily AI Hub</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
font-family:Arial,sans-serif;
background:#080b14;
color:#fff;
line-height:1.6
}
header{
position:sticky;
top:0;
z-index:99;
background:#0d1120;
border-bottom:1px solid #292f49;
padding:15px 18px;
display:flex;
justify-content:space-between;
align-items:center
}
.logo{font-size:21px;font-weight:800}
.logo span{color:#6c63ff}
.home{
color:#fff;
text-decoration:none;
background:#171c31;
border:1px solid #343b5b;
padding:8px 13px;
border-radius:9px
}
.container{
max-width:900px;
margin:auto;
padding:22px 16px 60px
}
.back{
display:inline-block;
color:#9b94ff;
text-decoration:none;
margin-bottom:22px
}
.badge{
display:inline-block;
background:#e52d55;
padding:6px 11px;
border-radius:7px;
font-size:12px;
font-weight:bold;
margin-bottom:15px
}
h1{
font-size:36px;
line-height:1.25;
margin-bottom:15px
}
.meta{
color:#8f97ae;
font-size:14px;
margin-bottom:22px
}
.viewer{
background:#111526;
border:1px solid #292f49;
border-radius:19px;
padding:24px
}
.summary{
font-size:18px;
color:#cbd0df;
line-height:1.8;
margin-bottom:25px
}
.content p{
font-size:17px;
color:#e0e3ec;
margin-bottom:17px
}
.source{
margin-top:25px;
padding-top:20px;
border-top:1px solid #292f49;
color:#9299ae
}
.source a{
color:#938aff;
text-decoration:none;
font-weight:bold
}
.buttons{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-top:22px
}
.btn{
display:inline-block;
padding:11px 16px;
border-radius:10px;
background:#6559f5;
color:#fff;
text-decoration:none;
border:0;
font-weight:bold;
cursor:pointer
}
.btn.secondary{
background:#1a2034;
border:1px solid #343b5b
}
.section{
margin-top:35px
}
.section h2{
font-size:25px;
margin-bottom:15px
}
.related{
display:block;
background:#111526;
border:1px solid #292f49;
border-radius:14px;
padding:15px;
margin-bottom:10px;
color:#fff;
text-decoration:none
}
.related small{
color:#938aff
}
.loading{
text-align:center;
padding:50px 10px;
color:#929ab2
}
.error{
background:#291620;
border:1px solid #7d2d4b;
border-radius:14px;
padding:20px;
color:#ffb5c8
}
footer{
border-top:1px solid #252b40;
text-align:center;
padding:28px;
color:#737b92
}
@media(max-width:600px){
h1{font-size:28px}
.viewer{padding:19px}
.summary{font-size:16px}
.content p{font-size:16px}
}
</style>
</head>

<body>

<header>
<div class="logo">🤖 Daily <span>AI Hub</span></div>
<a class="home" href="index.html">🏠 Home</a>
</header>

<main class="container">

<a class="back" href="index.html">← Back to Daily AI Hub</a>

<div id="loading" class="loading">
📰 Loading news...
</div>

<article id="viewer" style="display:none">

<div id="badge" class="badge">NEWS</div>

<h1 id="title"></h1>

<div id="meta" class="meta"></div>

<div class="viewer">

<div id="summary" class="summary"></div>

<div id="content" class="content"></div>

<div class="source">
Original Source:
<a id="sourceLink"
href="#"
target="_blank"
rel="noopener noreferrer">
Open Original Source →
</a>
</div>

<div class="buttons">

<a class="btn" href="index.html">
🏠 Home
</a>

<button class="btn secondary"
onclick="shareNews()">
📤 Share
</button>

</div>

</div>

</article>


<section class="section">

<h2>📰 More News</h2>

<div id="related">
<div class="loading">Loading...</div>
</div>

</section>

</main>

<footer>
© 2026 Daily AI Hub • News Viewer
</footer>


<script>

let articles=[];
let current=null;


/* LOAD JSON */

async function loadNews(){

try{

const response=
await fetch(
"news.json?cache="+Date.now()
);

if(!response.ok)
throw new Error("news.json unavailable");

const data=
await response.json();

articles=
Array.isArray(data)
?data
:(data.articles||[]);

if(!articles.length)
throw new Error("No articles found");


const params=
new URLSearchParams(
window.location.search
);

const requested=
params.get("index") ||
params.get("id");


let index=0;


/* Support index links */

if(requested!==null){

const number=
parseInt(requested);

if(!isNaN(number) &&
number>=0 &&
number<articles.length){

index=number;

}

}


current=articles[index];

showArticle(current);

showRelated(index);

}catch(error){

console.error(error);

document.getElementById("loading").innerHTML=
`
<div class="error">
⚠️ News could not be loaded.<br><br>
Please try again later.
</div>
`;

}

}


/* SHOW ARTICLE */

function showArticle(news){

document.getElementById("loading")
.style.display="none";

document.getElementById("viewer")
.style.display="block";


const title=
news.title ||
"Latest News";

const summary=
news.summary ||
news.description ||
"Latest news update.";

const content=
news.content ||
news.summary ||
news.description ||
"More information is available from the original source.";

const source=
news.source ||
"News Source";

const category=
news.category ||
"NEWS";

const date=
news.date ||
news.publishedAt ||
"Latest Update";

const link=
news.link ||
news.url ||
"#";


document.getElementById("badge")
.textContent=
category.toUpperCase();


document.getElementById("title")
.textContent=
title;


document.getElementById("meta")
.textContent=
"📰 "+source+" • 📅 "+date;


document.getElementById("summary")
.textContent=
summary;


/*
Only display supplied summary/content.
Do not copy another portal's full article.
*/

document.getElementById("content")
.innerHTML=
formatText(content);


document.getElementById("sourceLink")
.href=
safeURL(link);


document.title=
title+" | Daily AI Hub";

}


/* FORMAT TEXT */

function formatText(text){

return String(text)
.split(/\n+/)
.filter(Boolean)
.map(function(part){

return "<p>"+escapeHTML(part)+"</p>";

})
.join("");

}


/* RELATED NEWS */

function showRelated(currentIndex){

const box=
document.getElementById("related");

box.innerHTML="";

articles
.forEach(function(news,index){

if(index===currentIndex)
return;

const card=
document.createElement("a");

card.className="related";

card.href=
"news.html?index="+index;

card.innerHTML=
`
<small>
${escapeHTML(
news.category||"NEWS"
)}
</small>
<br>
<strong>
${escapeHTML(
news.title||"Latest News"
)}
</strong>
`;

box.appendChild(card);

});

}


/* SHARE */

async function shareNews(){

if(!current)
return;

const data={
title:current.title||"Daily AI Hub News",
text:current.title||"Latest News",
url:window.location.href
};

if(navigator.share){

try{
await navigator.share(data);
}catch(e){}

}else{

try{

await navigator.clipboard.writeText(
window.location.href
);

alert("News link copied!");

}catch(e){

alert("Copy the page link to share.");

}

}

}


/* SECURITY */

function escapeHTML(value){

return String(value)
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


function safeURL(value){

try{

const url=
new URL(
value||"#",
window.location.href
);

if(
url.protocol==="http:" ||
url.protocol==="https:"
){

return url.href;

}

}catch(e){}

return "#";

}


/* START */

loadNews();

</script>

</body>
</html>
