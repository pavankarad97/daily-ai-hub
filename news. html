<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080b14">

<title>News • Daily AI Hub</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:#080b14;
  color:#fff;
  line-height:1.5;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:#0d1120;
  border-bottom:1px solid #292f49;
  padding:14px 18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:22px;
  font-weight:800;
}

.logo span{
  color:#6c63ff;
}

.home{
  color:white;
  text-decoration:none;
  background:#171c31;
  border:1px solid #343b5b;
  padding:9px 14px;
  border-radius:10px;
}

.container{
  max-width:1000px;
  margin:auto;
  padding:25px 16px 60px;
}

h1{
  font-size:34px;
  margin-bottom:8px;
}

.subtitle{
  color:#aeb6d0;
  margin-bottom:20px;
}

.controls{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-bottom:25px;
}

input,select{
  background:#111629;
  color:white;
  border:1px solid #343b5b;
  border-radius:10px;
  padding:12px;
  font-size:15px;
  outline:none;
}

input{
  flex:1;
  min-width:220px;
}

select{
  min-width:140px;
}

.status{
  background:#111629;
  border:1px solid #292f49;
  padding:12px 15px;
  border-radius:12px;
  margin-bottom:18px;
  color:#aeb6d0;
}

.news-card{
  background:#111629;
  border:1px solid #292f49;
  border-radius:16px;
  padding:18px;
  margin-bottom:15px;
  transition:.2s;
}

.news-card:hover{
  transform:translateY(-2px);
  border-color:#6c63ff;
}

.badge{
  display:inline-block;
  background:#252b49;
  color:#9b94ff;
  padding:5px 9px;
  border-radius:7px;
  font-size:12px;
  font-weight:bold;
  margin-bottom:10px;
}

.news-title{
  font-size:20px;
  font-weight:700;
  margin-bottom:10px;
}

.news-meta{
  color:#8992ae;
  font-size:13px;
  margin-bottom:13px;
}

.read{
  display:inline-block;
  color:white;
  background:#5d54f5;
  text-decoration:none;
  padding:9px 13px;
  border-radius:9px;
  font-weight:bold;
}

.empty{
  text-align:center;
  padding:50px 20px;
  color:#9da6c0;
}

footer{
  text-align:center;
  color:#737c98;
  padding:25px;
  border-top:1px solid #292f49;
}

@media(max-width:600px){
  h1{
    font-size:28px;
  }

  .news-title{
    font-size:18px;
  }

  .home{
    padding:8px 10px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">🤖 Daily <span>AI Hub</span></div>
  <a class="home" href="index.html">🏠 Home</a>
</header>

<main class="container">

  <h1>📰 Latest News</h1>

  <p class="subtitle">
    India • World • Technology • AI • Cricket • Movies
  </p>

  <div class="controls">

    <input
      type="search"
      id="search"
      placeholder="🔎 Search news..."
    >

    <select id="category">
      <option value="all">All Categories</option>
      <option value="India">🇮🇳 India</option>
      <option value="World">🌍 World</option>
      <option value="Trending">🔥 Trending</option>
      <option value="Cricket">🏏 Cricket</option>
      <option value="Technology">💻 Technology</option>
      <option value="AI">🤖 AI</option>
      <option value="Movies">🎬 Movies</option>
    </select>

    <select id="language">
      <option value="all">All Languages</option>
      <option value="hi">Hindi</option>
      <option value="en">English</option>
      <option value="mr">Marathi</option>
      <option value="ta">Tamil</option>
      <option value="te">Telugu</option>
      <option value="bn">Bengali</option>
      <option value="kn">Kannada</option>
      <option value="ml">Malayalam</option>
      <option value="gu">Gujarati</option>
      <option value="pa">Punjabi</option>
    </select>

  </div>

  <div class="status" id="status">
    ⏳ Loading latest news...
  </div>

  <section id="newsList"></section>

</main>

<footer>
  🤖 Daily AI Hub • Latest News Updates
</footer>

<script>

let allNews = [];

const newsList = document.getElementById("newsList");
const search = document.getElementById("search");
const category = document.getElementById("category");
const language = document.getElementById("language");
const statusBox = document.getElementById("status");

